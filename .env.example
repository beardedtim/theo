POSTGRES_USER=theo
POSTGRES_PASSWORD=theo
POSTGRES_DB=theo
POSTGRES_PORT=5432

# together.ai API key for the LLM enrichment pipeline (llm_annotate_pericopes.py).
TOGETHER_API_KEY=

# Minimum seconds between together.ai request dispatches, shared across every
# worker thread in llm_annotate_pericopes.py (overridden by its
# --min-request-interval flag). Raise this if a run is hitting 429s.
# TOGETHER_MIN_REQUEST_INTERVAL=0.5

# "prd" enables production logging (stdout + file); anything else uses Rich.
ENV_STATE=dev
# Log file path; parent directory is created automatically if missing.
LOG_FILE=theo.server.log
