# syntax=docker/dockerfile:1

# Builder: resolves/installs the uv-managed venv (torch, spaCy, sentence-
# transformers, en_core_web_trf, ...). This image is large by nature of the
# NLP/embedding stack -- expect a multi-GB build on first run.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Dependencies first so this layer is only invalidated by pyproject.toml/uv.lock
# changes, not by every source edit.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY main.py ./
COPY theo ./theo
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Runtime: no compiler/uv, just the venv + source, run as a non-root user.
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 theo \
    && mkdir -p /app/logs && chown theo:theo /app/logs

COPY --from=builder --chown=theo:theo /app/.venv ./.venv
COPY --from=builder --chown=theo:theo /app/main.py ./main.py
COPY --from=builder --chown=theo:theo /app/theo ./theo

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER theo
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fs http://localhost:8000/health || exit 1

CMD ["uvicorn", "theo.server:app", "--host", "0.0.0.0", "--port", "8000"]
